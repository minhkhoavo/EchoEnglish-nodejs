MONGO_URI=
PORT=
SMTP_USER=
SMTP_PASS=
# jwt
JWT_SECRETKEY=
# AWS S3
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SPEECH_KEY=
SPEECH_REGION=
# VNPAY
FRONTEND_URL=http://localhost:5173
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_TMNCODE=
VNP_HASH_SECRET=
VNP_RETURN_URL=http://localhost:4000/payments/vnpay/return
# Payment Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4000/payments/stripe/return
STRIPE_CANCEL_URL=http://localhost:5173/payment/callback?status=FAILED
STRIPE_CURRENCY=vnd
# Gemini
GENAI_API_KEY=

# AI Model Configuration
# Model for general AI services (learningPlan, toeicAnalysis, dailyPlan, roadmap)
# Options:  gemma-3-27b-it (30 RPM, 14.4K RPD) | gemini-2.5-flash-lite (10 RPM, 20 RPD) | gemini-2.5-flash (5 RPM, 20 RPD)
GEMINI_DEFAULT_MODEL=gemma-3-27b-it

# Model for chatbot agent (must be Gemini for function calling support)
# Options: gemini-2.5-flash-lite | gemini-2.5-flash 
GEMINI_CHATBOT_CONSERVATION_MODEL=gemini-2.5-flash-lite

# ChromaDB
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# Langsmith 
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Environment: development | production
NODE_ENV='development'
# ---------------------------------------------------------------
# Recommendation platform (see docs/recommendation/)
# ---------------------------------------------------------------
# Master switch: when not "true" no events are written and the ETL scheduler is off.
RECSYS_ENABLED=false
# Raw/clean event retention in days (TTL index; privacy by design)
RECSYS_EVENT_RETENTION_DAYS=400
# ETL micro-batch size
RECSYS_PIPELINE_BATCH=2000
# Debug/kill switch: force one A/B variant for everyone (control | srs_heavy)
RECSYS_FORCE_VARIANT=
# Per-model LLM prices in USD per 1M tokens, set from the provider's current price list, e.g.
# {"gemini-2.5-flash-lite":{"in":0.10,"out":0.40}}  (unknown model => cost recorded as 0, tokens still recorded)
RECSYS_AI_RATES_JSON=
# Used to express AI cost vs revenue (VND) in KPI endpoints
RECSYS_USD_VND=25000

# --- Phase 3 (scale) — all OFF by default; Mongo stays the system of record ---
# Required (>=16 chars, secret) before ANY analytics export; exports fail closed without it.
RECSYS_PSEUDONYM_SALT=
RECSYS_STREAM_ENABLED=false
RECSYS_STREAM_BROKERS=
RECSYS_STREAM_TOPIC=echo.learning_events.v1
RECSYS_STREAM_RETENTION_HOURS=168
RECSYS_DEFAULT_REGION=vn
